<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlayLand"
        tools:targetApi="31">
        <activity
            android:name=".GameOverActivity"
            android:exported="false" />
        <activity
            android:name=".JuegoEnCursoActivity"
            android:exported="false" />
        <activity
            android:name=".InicioSimulacionActivity"
            android:exported="false" />
        <activity
            android:name=".EstadisticasActivity"
            android:exported="true"
            android:label="Estadisticas"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".DetalleJuegoActivity"
            android:exported="true"
            android:label="Detalle Juego"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".CategoriaActivity"
            android:exported="false"
            android:label="@string/title_activity_categoria"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".JuegosHabilidadActivity"
            android:exported="false"
            android:label="@string/title_activity_juegos_habilidad"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".JuegosCarrerasActivity"
            android:exported="false"
            android:label="@string/title_activity_juegos_carreras"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".JuegosPuzzleActivity"
            android:exported="false"
            android:label="@string/title_activity_juegos_puzzle"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".JuegosAventuraActivity"
            android:exported="false"
            android:label="@string/title_activity_juegos_aventura"
            android:theme="@style/Theme.PlayLand" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.PlayLand">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>