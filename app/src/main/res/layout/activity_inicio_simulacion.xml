<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <EditText
        android:id="@+id/etNombreJugador"
        android:hint="Nombre del jugador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <RadioGroup
        android:id="@+id/rgDificultad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rbNovato"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Novato" />

        <RadioButton
            android:id="@+id/rbAmateur"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Amateur" />

        <RadioButton
            android:id="@+id/rbProfesional"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Profesional" />
    </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="507dp"
        android:orientation="vertical">

        <Space
            android:layout_width="match_parent"
            android:layout_height="335dp" />

        <Button
            android:id="@+id/btnIniciarJuego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:text="Jugar"
            android:background="@drawable/btn_rounded_green"
            android:textColor="@color/btn_text_green" />

        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_rounded_blue"
            android:text="Volver"
            android:textColor="@color/btn_text_blue" />
    </LinearLayout>

</LinearLayout>
