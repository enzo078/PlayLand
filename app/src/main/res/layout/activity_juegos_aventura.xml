<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/title_background"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:padding="8dp">

            <TextView
                android:text="Juegos de Aventura"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- Juego 1 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/aventura_juego1"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnJuego1"
                android:text="Explorador Fantástico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_rounded_green"
                android:textColor="@color/btn_text_green"/>
        </LinearLayout>

        <!-- Juego 2 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/aventura_juego2"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnJuego2"
                android:text="Selva Misteriosa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_rounded_green"
                android:textColor="@color/btn_text_green"/>
        </LinearLayout>

        <!-- Juego 3 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/aventura_juego3"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnJuego3"
                android:text="Cueva del Tesoro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_rounded_green"
                android:textColor="@color/btn_text_green"/>
        </LinearLayout>

        <!-- Juego 4 -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:src="@drawable/aventura_juego4"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btnJuego4"
                android:text="Isla Perdida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_rounded_green"
                android:textColor="@color/btn_text_green"/>
        </LinearLayout>

        <!-- Botón Volver -->
        <Button
            android:id="@+id/btnVolverCategorias"
            android:text="Volver a Categorías"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_rounded_blue"
            android:textColor="@color/btn_text_blue"
            android:layout_gravity="center_horizontal"/>
    </LinearLayout>
</ScrollView>
